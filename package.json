{
  "name": "imagine",
  "version": "0.1.0",
  "description": "Disk Image Engine for retro systems (C64, Amiga, Atari ST, DOS and more)",
  "license": "GPL-3.0-or-later",
  "author": "Dennis Rapp <info@dennisrapp.com>",
  "homepage": "https://github.com/it-dennis/imagine_app",
  "repository": {
    "type": "git",
    "url": "https://github.com/it-dennis/imagine_app.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "dev.dennisrapp.imagine",
    "productName": "Imagine",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.3.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "i18next": "^23.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.1",
    "zustand": "^4.5.2"
  }
}
